{
  "name": "eva",
  "private": true,
  "version": "2.5.1",
  "description": "Eva - Advanced AI Chatbot — a privacy-first, memory-aware AI character and chat studio for any OpenAI-compatible provider (Groq, OpenRouter, Ollama, LM Studio).",
  "author": "Eva",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --base=./",
    "build:web": "tsc -b && vite build --base=./",
    "deploy:web": "npm run build:web && rm -rf docs/app/* && cp -r dist/* docs/app/",
    "electron:dev": "node scripts/dev-electron.mjs",
    "dist": "npm run build:electron && electron-builder",
    "pack:win": "npm run build:electron && electron-builder --win",
    "pack:linux": "npm run build:electron && electron-builder --linux",
    "pack:mac": "npm run build:electron && electron-builder --mac",
    "cap:sync": "npm run build:web && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "test": "vitest run",
    "test:image-gen:ui": "npm run build && node tests/e2e/imageGen.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nexus.chatstudio",
    "productName": "Eva",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "build/icon.png",
      "executableName": "eva",
      "category": "Utility",
      "synopsis": "Eva - Advanced AI Chatbot",
      "description": "Eva - Advanced AI Chatbot — a multi-theme, memory-aware AI character chat studio.",
      "maintainer": "Eva <noreply@example.com>",
      "artifactName": "Eva-${version}.${ext}"
    },
    "deb": {
      "artifactName": "eva_${version}_${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "eva-${version}.${arch}.${ext}"
    },
    "pacman": {
      "artifactName": "eva-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "artifactName": "Eva-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.11.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
